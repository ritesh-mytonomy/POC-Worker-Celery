# Ingest Worker POC — POC values from specs/ingest-worker-poc/design.md §9.
# Copy to .env. Durations are in seconds; sizes are in bytes; lists are comma-separated.

# Workers and Celery
INGEST_CONCURRENCY=2
MAX_ATTEMPTS=3
TASK_SOFT_TIME_LIMIT=120
TASK_TIME_LIMIT=150
# Must exceed TASK_TIME_LIMIT — validated at startup
VISIBILITY_TIMEOUT=300

# Liveness and sweepers
HEARTBEAT_SECONDS=5
# Must be at least 3 x HEARTBEAT_SECONDS — validated at startup
STALE_AFTER_SECONDS=30
SWEEP_INTERVAL_SECONDS=15
RECONCILE_AFTER_SECONDS=30
# An upload still staged or uploading after this long is abandoned: multipart aborted, file error (prod 86400)
UPLOAD_ABANDON_SECONDS=3600

# Archive guards
MAX_ZIP_ENTRIES=500
# 500 MB
MAX_ZIP_UNCOMPRESSED_BYTES=524288000
MAX_COMPRESSION_RATIO=200
ALLOWED_ZIP_ENTRY_EXT=docx
ALLOWED_TOP_LEVEL_EXT=docx,zip
# Entries deeper than this many folders inside a zip are rejected
MAX_ZIP_FOLDER_DEPTH=1

# POC only — per-scenario override (S4: 1 · S5, S5b, S7: 2)
ENTRY_DELAY_SECONDS=0
POC_ORGANIZATION_ID=00000000-0000-4000-8000-000000000001
# created_by / version_uploaded_by until auth exists: 0, the system actor (OD-19)
POC_USER_ID=0

# Internal API
INTERNAL_API_BASE_URL=http://api:8000
# Must be non-empty
INTERNAL_API_KEY=change-me-local-only

# Infrastructure
# LocalStack auth token — set it in .env only, never commit a real value
# TODO: a token is required — this LocalStack image refuses to start without one (README, task 14.1)
LOCALSTACK_AUTH_TOKEN=
AWS_ENDPOINT_URL=http://localstack:4566
# The host a browser can reach: presigned URLs are signed for it, so it cannot be rewritten later. Unset in AWS
S3_PUBLIC_ENDPOINT_URL=http://localhost:4566
PRESIGN_EXPIRES_SECONDS=3600
# 8 MiB; must be >= 5 MiB (S3's minimum part size) — validated at startup
UPLOAD_PART_SIZE_BYTES=8388608
# 5 GiB — larger initiates get 413
MAX_UPLOAD_BYTES=5368709120
DOWNLOAD_URL_EXPIRES_SECONDS=300
# Browser origins allowed to call the API (the bucket's CORS rule is in infra/localstack/init-s3.sh)
CORS_ORIGINS=http://localhost:5173
# LocalStack accepts any credentials (compose defaults these to test/test/us-east-1); production uses an IAM role
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET=clinsync-poc
REDIS_URL=redis://redis:6379/0
# PostgreSQL — docker-compose.yml reads these; the app builds DATABASE_URL from them
POSTGRES_USER=clinsync
POSTGRES_PASSWORD=clinsync
POSTGRES_DB=clinsync
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# Optional explicit override (e.g. RDS); when unset it is built from POSTGRES_* above
# DATABASE_URL=postgresql+psycopg://clinsync:clinsync@postgres:5432/clinsync
